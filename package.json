{
  "name": "@sarutobi-sasuke/agent-handoff-mcp",
  "version": "0.1.0",
  "description": "A local-first MCP server for bounded, auditable handoffs between AI agents.",
  "license": "Apache-2.0",
  "author": "Alexei Udall",
  "homepage": "https://github.com/SarutobiSasuke8/agent-handoff-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SarutobiSasuke8/agent-handoff-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/SarutobiSasuke8/agent-handoff-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "handoff",
    "multi-agent"
  ],
  "bin": {
    "agent-handoff-mcp": "dist/src/cli.js",
    "agent-handoff-http": "dist/src/http.js",
    "agent-handoff-stdio": "dist/src/stdio.js",
    "agent-handoff-token": "scripts/generate-token.mjs",
    "agent-handoff-validate": "dist/src/bin-validate.js"
  },
  "exports": {
    ".": "./dist/src/server.js",
    "./http": "./dist/src/http.js",
    "./stdio": "./dist/src/stdio.js",
    "./registry": "./dist/src/registry.js",
    "./service": "./dist/src/service.js",
    "./store": "./dist/src/store.js"
  },
  "files": [
    "dist/src",
    "scripts/generate-token.mjs",
    "config/agents.example.yaml",
    "schema",
    "docs",
    ".env.example",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "ROADMAP.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/http.ts",
    "dev:stdio": "node --env-file-if-exists=.env --import tsx src/stdio.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/http.js",
    "start:stdio": "node --env-file-if-exists=.env dist/src/stdio.js",
    "token:new": "node scripts/generate-token.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "test:e2e": "npm run build && node --test --test-concurrency=1 \"dist/test/e2e/*.test.js\"",
    "schema:write": "npm run build && node scripts/write-schema.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepublishOnly": "npm run check && npm run test:e2e && node scripts/verify-pack.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/express": "5.0.6",
    "@types/node": "22.19.15",
    "eslint": "10.8.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12"
  }
}
