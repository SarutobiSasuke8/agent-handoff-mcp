{
  "name": "@sarutobi-sasuke/agent-handoff-mcp",
  "mcpName": "io.github.SarutobiSasuke8/agent-handoff-mcp",
  "version": "0.1.0",
  "description": "A local-first MCP server for bounded, auditable handoffs between AI agents.",
  "license": "Apache-2.0",
  "author": "Alexei Udall",
  "homepage": "https://github.com/SarutobiSasuke8/agent-handoff-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SarutobiSasuke8/agent-handoff-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/SarutobiSasuke8/agent-handoff-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "handoff",
    "multi-agent"
  ],
  "bin": {
    "agent-handoff-mcp": "dist/src/cli.js",
    "agent-handoff-http": "dist/src/http.js",
    "agent-handoff-stdio": "dist/src/stdio.js",
    "agent-handoff-token": "scripts/generate-token.mjs",
    "agent-handoff-validate": "dist/src/bin-validate.js"
  },
  "exports": {
    ".": "./dist/src/server.js",
    "./http": "./dist/src/http.js",
    "./stdio": "./dist/src/stdio.js",
    "./registry": "./dist/src/registry.js",
    "./service": "./dist/src/service.js",
    "./store": "./dist/src/store.js"
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts",
    "scripts/generate-token.mjs",
    "config/agents.example.yaml",
    "schema/agent-registry.schema.v1.json",
    "docs/ARCHITECTURE.md",
    "docs/PROTOCOL.md",
    "docs/QUICKSTART.md",
    "docs/RECOVERY.md",
    "docs/CONFORMANCE-2026-10-21.md",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "ROADMAP.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/http.ts",
    "dev:stdio": "node --env-file-if-exists=.env --import tsx src/stdio.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/http.js",
    "start:stdio": "node --env-file-if-exists=.env dist/src/stdio.js",
    "token:new": "node scripts/generate-token.mjs",
    "check:plugin": "node scripts/check-plugin.mjs",
    "check:registry": "npm run build:package && node scripts/check-registry-pack.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --test --test-timeout=60000 \"dist/test/*.test.js\"",
    "test:e2e": "npm run build && node --test --test-concurrency=1 --test-timeout=120000 \"dist/test/e2e/*.test.js\"",
    "test:coverage": "npm run build && node scripts/run-src-coverage.mjs",
    "eval:contract": "npm run build && mcp-eval eval/mcp.suite.yaml",
    "schema:write": "npm run build && node scripts/write-schema.mjs",
    "release:dry-run": "node scripts/release-dry-run.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepublishOnly": "npm run check && npm run test:e2e && node scripts/verify-pack.mjs && npm run check:registry",
    "prepare": "npm run build:package",
    "build:package": "tsc -p tsconfig.package.json",
    "conformance": "npm run build && node tools/conformance.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "express": "5.3.0",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@sarutobi-sasuke/mcp-eval-harness": "github:SarutobiSasuke8/mcp-eval-harness#077c74a60ccd6d9061e35f882ffd3db5f5d17052",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "@modelcontextprotocol/client": "$@modelcontextprotocol/client"
  },
  "optionalDependencies": {
    "pg": "8.23.1"
  }
}
