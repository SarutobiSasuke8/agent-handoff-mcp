{
  "$id": "https://raw.githubusercontent.com/SarutobiSasuke8/agent-handoff-mcp/main/schema/agent-registry.schema.v1.json",
  "title": "Agent Handoff MCP agent registry (schema version 1)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "agents": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "enabled": {
            "type": "boolean"
          },
          "send_to": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
                },
                {
                  "type": "string",
                  "const": "*"
                }
              ]
            }
          },
          "receive_from": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
                },
                {
                  "type": "string",
                  "const": "*"
                }
              ]
            }
          },
          "disclosure_ceiling": {
            "type": "string",
            "enum": [
              "public-safe",
              "internal",
              "restricted"
            ]
          },
          "token_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "id",
          "display_name",
          "enabled",
          "send_to",
          "receive_from",
          "disclosure_ceiling"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "agents"
  ],
  "additionalProperties": false
}
