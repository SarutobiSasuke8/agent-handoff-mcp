{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_refs": {
      "default": [],
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "type": "array"
    },
    "context_refs": {
      "default": [],
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "type": "array"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 8,
      "type": "string"
    },
    "parent_id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "priority": {
      "default": "normal",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "type": "string"
    },
    "recipient": {
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$",
      "type": "string"
    },
    "request": {
      "maxLength": 8000,
      "minLength": 1,
      "type": "string"
    },
    "sensitivity": {
      "default": "internal",
      "enum": [
        "public-safe",
        "internal",
        "restricted"
      ],
      "type": "string"
    },
    "summary": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
    },
    "tags": {
      "default": [],
      "items": {
        "maxLength": 50,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "type": "array"
    },
    "title": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "recipient",
    "title",
    "summary",
    "request"
  ],
  "type": "object"
}
