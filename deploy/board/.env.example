# Copy to deploy/board/.env (never commit the copy) and edit.
# Public host name for the demo. Placeholder until the operator sets up DNS.
HANDOFF_PUBLIC_HOST=handoff.astraeus.ie
# Contact address for Let's Encrypt expiry notices.
ACME_EMAIL=ops@example.com

# Edge rate limit per client IP (Traefik): average requests per minute, plus burst.
PROXY_RATE_AVERAGE=60
PROXY_RATE_BURST=20

# In-app limiter (express-rate-limit), applied after the proxy, keyed on the client IP.
HANDOFF_MCP_RATE_LIMIT=120
HANDOFF_MCP_RATE_WINDOW_MS=60000
HANDOFF_MCP_MAX_MESSAGE_BYTES=32768

# Number of backup snapshots to keep on the backups volume.
HANDOFF_BACKUP_KEEP=14
